// Logs: syslog, auth and (on the IDS host) Suricata eve.json -> Loki
local.file_match "logs" {
  path_targets = [
    {"__path__" = "/var/log/syslog",    "job" = "syslog", "host" = "{{ inventory_hostname }}"},
    {"__path__" = "/var/log/auth.log",  "job" = "auth",   "host" = "{{ inventory_hostname }}"},
{% if inventory_hostname in groups['onprem_ids'] | default([]) %}
    {"__path__" = "/var/log/suricata/eve.json", "job" = "suricata", "host" = "{{ inventory_hostname }}"},
{% endif %}
  ]
}

loki.source.file "logs" {
  targets    = local.file_match.logs.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "{{ loki_url }}/loki/api/v1/push"
  }
}

// Metrics: node exporter built into Alloy -> Prometheus remote_write
prometheus.exporter.unix "node" { }

prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.remote_write.default.receiver]
  scrape_interval = "30s"
}

prometheus.remote_write "default" {
  endpoint {
    url = "{{ prometheus_url }}/api/v1/write"
  }
  external_labels = { host = "{{ inventory_hostname }}" }
}
