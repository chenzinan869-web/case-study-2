global:
  scrape_interval: 30s
scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # The SOAR monitors itself: every Fargate task exposes /metrics.
  # Cloud Map returns one A record per running task, so each task is scraped separately.
  - job_name: soar
    metrics_path: /metrics
    dns_sd_configs:
      - names: ["soar.svc.{{ internal_domain }}"]
        type: A
        port: 8080
        refresh_interval: 15s
