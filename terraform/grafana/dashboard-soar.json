{
  "uid": "soar-monitoring",
  "title": "SOAR monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Running SOAR tasks", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "count(up{job=\"soar\"} == 1)"}]},
    {"id": 2, "type": "stat", "title": "Failed actions (1h)", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(soar_action_failures_total[1h]))"}]},
    {"id": 3, "type": "stat", "title": "Rejected webhook calls (1h)", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(soar_webhook_unauthorized_total[1h]))"}]},
    {"id": 4, "type": "stat", "title": "Database errors (1h)", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(soar_db_errors_total[1h]))"}]},
    {"id": 5, "type": "timeseries", "title": "Events processed per second, by action", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (action) (rate(soar_alerts_total[5m]))", "legendFormat": "{{action}}"}]},
    {"id": 6, "type": "timeseries", "title": "Events processed per second, by severity", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (severity) (rate(soar_alerts_total[5m]))", "legendFormat": "{{severity}}"}]},
    {"id": 7, "type": "timeseries", "title": "Webhook latency p95 (seconds)", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(soar_webhook_duration_seconds_bucket[5m])))"}]},
    {"id": 8, "type": "logs", "title": "Suricata alerts (Loki)", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "{job=\"suricata\"}"}]}
  ]
}